# LeoDigi CyberPanel Toolkit defaults. Secrets belong in SECRETS_DIR only.
# Official website: https://leodigi.dev
INSTALL_DIR=/opt/leodigi-cyberpanel-toolkit
CONFIG_DIR=/etc/leodigi-cyberpanel-toolkit
STATE_DIR=/var/lib/leodigi-cyberpanel-toolkit
LOG_DIR=/var/log/leodigi-cyberpanel-toolkit
BACKUP_DIR=/var/backups/leodigi-cyberpanel-toolkit
SECRETS_DIR=/etc/leodigi-cyberpanel-toolkit/secrets
LOCK_FILE=/run/lock/leodigi-cyberpanel-toolkit.lock
APPLY_CHANGES=no
AUTO_RESTART=yes
BACKUP_RETENTION_DAILY=7
BACKUP_RETENTION_WEEKLY=4
BACKUP_RETENTION_MONTHLY=6
BACKUP_RETENTION_YEARLY=1
BACKUP_BWLIMIT=0
MALWARE_QUARANTINE=yes
MALWARE_AUTO_DELETE=no
FIREWALL_MANAGE=no
FIREWALL_SSH_PORT=22
DASHBOARD_BIND=127.0.0.1
DASHBOARD_PORT=9443
DASHBOARD_WORKERS=2
ALERT_EMAIL=
TELEGRAM_CHAT_ID=
NETDATA_INSTALL=no
RSPAMD_INSTALL=no
RESTIC_CACHE_DIR=/var/cache/leodigi-cyberpanel-toolkit/restic
