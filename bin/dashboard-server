#!/usr/bin/env bash
set -Eeuo pipefail

CONFIG_FILE=${CPT_CONFIG:-/etc/leodigi-cyberpanel-toolkit/toolkit.env}
[[ -r "$CONFIG_FILE" ]] && source "$CONFIG_FILE"

INSTALL_DIR=${INSTALL_DIR:-/opt/leodigi-cyberpanel-toolkit}
DASHBOARD_BIND=${DASHBOARD_BIND:-127.0.0.1}
DASHBOARD_PORT=${DASHBOARD_PORT:-9443}
DASHBOARD_WORKERS=${DASHBOARD_WORKERS:-2}
DASHBOARD_TLS=${DASHBOARD_TLS:-no}

[[ "$DASHBOARD_PORT" =~ ^[0-9]+$ ]] && ((DASHBOARD_PORT >= 1 && DASHBOARD_PORT <= 65535)) || {
  echo "Invalid DASHBOARD_PORT: $DASHBOARD_PORT" >&2
  exit 1
}

args=(
  "$INSTALL_DIR/dashboard/.venv/bin/uvicorn" app:app
  --host "$DASHBOARD_BIND"
  --port "$DASHBOARD_PORT"
  --workers "$DASHBOARD_WORKERS"
)

if [[ "$DASHBOARD_TLS" == yes ]]; then
  : "${DASHBOARD_CERT_FILE:?DASHBOARD_CERT_FILE is required when DASHBOARD_TLS=yes}"
  : "${DASHBOARD_KEY_FILE:?DASHBOARD_KEY_FILE is required when DASHBOARD_TLS=yes}"
  [[ -r "$DASHBOARD_CERT_FILE" ]] || { echo "Certificate not readable: $DASHBOARD_CERT_FILE" >&2; exit 1; }
  [[ -r "$DASHBOARD_KEY_FILE" ]] || { echo "Private key not readable: $DASHBOARD_KEY_FILE" >&2; exit 1; }
  args+=(--ssl-certfile "$DASHBOARD_CERT_FILE" --ssl-keyfile "$DASHBOARD_KEY_FILE")
fi

cd "$INSTALL_DIR/dashboard"
exec "${args[@]}"
