[Unit]
Description=LeoDigi CyberPanel Toolkit dashboard
After=network.target

[Service]
Type=simple
EnvironmentFile=/etc/leodigi-cyberpanel-toolkit/toolkit.env
EnvironmentFile=/etc/leodigi-cyberpanel-toolkit/secrets/dashboard.env
WorkingDirectory=/opt/leodigi-cyberpanel-toolkit/dashboard
ExecStart=/opt/leodigi-cyberpanel-toolkit/bin/dashboard-server
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/etc/leodigi-cyberpanel-toolkit /etc/systemd/system /var/lib/leodigi-cyberpanel-toolkit /var/log/leodigi-cyberpanel-toolkit /var/cache/leodigi-cyberpanel-toolkit

[Install]
WantedBy=multi-user.target
